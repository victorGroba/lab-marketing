generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  TI
  DIRETOR
}

enum StatusPost {
  RASCUNHO
  REVISAO
  APROVADO
  PUBLICADO
}

model User {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  senhaHash  String
  papel      Papel
  criadoEm  DateTime @default(now())

  posts        Post[]       @relation("CriadoPor")
  imagens      Imagem[]     @relation("EnviadoPor")
  comentarios  Comentario[] @relation("AutorComentario")
  historicos   Historico[]  @relation("AutorHistorico")

  // Auth.js
  sessions     Session[]
  accounts     Account[]
}

model Post {
  id              String     @id @default(cuid())
  titulo          String
  pilar           String
  baseNormativa   String?
  textoArte       String?
  legenda         String?
  hashtags        String?
  promptImagem    String?
  status          StatusPost @default(RASCUNHO)
  dataAgendada    DateTime?
  criadoPorId     String
  criadoEm       DateTime   @default(now())
  atualizadoEm   DateTime   @updatedAt

  criadoPor    User         @relation("CriadoPor", fields: [criadoPorId], references: [id])
  imagens      Imagem[]
  comentarios  Comentario[]
  historicos   Historico[]
}

model Imagem {
  id            String   @id @default(cuid())
  postId        String
  caminhoArquivo String
  versao        Int      @default(1)
  enviadoPorId  String
  enviadoEm     DateTime @default(now())

  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  enviadoPor User @relation("EnviadoPor", fields: [enviadoPorId], references: [id])
}

model Comentario {
  id        String   @id @default(cuid())
  postId    String
  autorId   String
  texto     String
  criadoEm DateTime @default(now())

  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  autor User @relation("AutorComentario", fields: [autorId], references: [id])
}

model Historico {
  id         String   @id @default(cuid())
  postId     String
  autorId    String
  campo      String
  valorAntigo String?
  valorNovo  String?
  criadoEm  DateTime @default(now())

  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  autor User @relation("AutorHistorico", fields: [autorId], references: [id])
}

// Auth.js tabelas obrigatorias
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
